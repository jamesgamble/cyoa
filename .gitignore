# Dependencies and build output
node_modules/
frontend/dist/
*.tsbuildinfo

# Built frontend copied into the web root by scripts/build.sh
public/index.html
public/assets/

# Runtime data: never commit
private/data/*
!private/data/.gitkeep
private/keys/*
!private/keys/.gitkeep
private/locks/*
!private/locks/.gitkeep
private/logs/*
!private/logs/.gitkeep
private/backups/*
!private/backups/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
*.log
