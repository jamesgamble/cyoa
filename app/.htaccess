# Branching Paths — deny all web access to private runtime data.
# Only needed in the fallback layout where private/ sits under the
# document root. The recommended layout keeps private/ outside it.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
Options -Indexes
