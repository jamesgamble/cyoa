# Branching Paths — environment example
# Copy to .env and fill in real values on the server. Do not commit .env.

APP_ENV=production
APP_URL=https://cyoa.gamblelan.com

# SQLite database file path (absolute recommended in production).
DATABASE_PATH=private/data/branching-paths.sqlite

# Write lock file path.
WRITE_LOCK_PATH=private/locks/write.lock

# SMTP2GO credentials (used starting v0.12.0).
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cyoa.gamblelan.com
SMTP_FROM_NAME=Branching Paths

# Session / security (used in later versions).
SESSION_NAME=bp_session
SESSION_SECURE=1
