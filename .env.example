# Branching Paths — environment template (see docs/ENVIRONMENT.md).
# There is no .env loader: copy these into Apache SetEnv, PHP-FPM env[...],
# Nginx fastcgi_param, or shell exports for cron. Never commit real values.

APP_ENV=production

# Public base address, no trailing slash. Every emailed link uses it.
APP_URL=https://cyoa.gamblelan.com

# Absolute paths outside the web root are recommended.
DATABASE_PATH=/var/lib/branching-paths/data/branching-paths.sqlite
WRITE_LOCK_PATH=/var/lib/branching-paths/locks/write.lock

# SMTP is configured by an administrator in /master/settings, not here.
